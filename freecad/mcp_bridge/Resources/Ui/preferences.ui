<ui version="4.0">
 <class>MCPBridgePreferences</class>
 <widget class="QWidget" name="MCPBridgePreferences">
  <property name="windowTitle">
   <string>MCP Bridge</string>
  </property>
  <layout class="QVBoxLayout" name="pageLayout">
   <property name="spacing">
    <number>6</number>
   </property>
   <item>
    <widget class="QLabel" name="serverHint">
     <property name="textFormat">
      <enum>Qt::RichText</enum>
     </property>
     <property name="text">
      <string>To start or stop the bridge, click &lt;b&gt;MCP On/Off&lt;/b&gt; in the status bar.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="topRow">
     <item>
      <widget class="QGroupBox" name="listenGroup">
       <property name="title">
        <string>Listen addresses</string>
       </property>
       <layout class="QVBoxLayout" name="listenLayout">
        <item>
         <widget class="QTableWidget" name="listenTable">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>1</horstretch>
            <verstretch>1</verstretch>
           </sizepolicy>
          </property>
          <property name="selectionMode">
