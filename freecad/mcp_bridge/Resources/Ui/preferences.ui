        </item>
        <item>
         <widget class="Gui::PrefFileChooser" name="tlsKeyFileChooser">
          <property name="toolTip">
           <string>PEM private key file for HTTPS.</string>
          </property>
          <property name="fileName">
           <string/>
          </property>
          <property name="filter">
           <string>PEM files (*.pem *.crt *.key);;All files (*)</string>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>TlsKeyFile</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>Mod/freecad-mcp-bridge</cstring>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="tlsGenerateRow">
        <item>
         <widget class="QLabel" name="certTrustLabel">
          <property name="text">
           <string>An MCP client must trust this certificate.</string>
          </property>
          <property name="wordWrap">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="tlsGenerateSpacer">
