            <width>20</width>
            <height>10</height>
           </size>
          </property>
         </spacer>
        </item>
        <item>
         <widget class="QLabel" name="optionalLabel">
          <property name="text">
           <string>(Optional)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="generateCertButton">
