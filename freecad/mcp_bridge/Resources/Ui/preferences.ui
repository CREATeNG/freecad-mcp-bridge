  <layout class="QVBoxLayout" name="pageLayout">
   <item>
    <widget class="QGroupBox" name="serverGroup">
     <property name="title">
      <string>Server</string>
     </property>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0" colspan="2">
       <widget class="QLabel" name="serverHint">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>To start or stop the bridge, click &lt;b&gt;MCP Bridge On/Off&lt;/b&gt; in the &lt;b&gt;MCP Bridge&lt;/b&gt; toolbar. While active, it listens on the port configured below.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="portLabel">
