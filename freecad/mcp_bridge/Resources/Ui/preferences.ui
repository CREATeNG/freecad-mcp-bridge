   <item>
    <layout class="QHBoxLayout" name="tokenRow">
     <item>
      <widget class="QGroupBox" name="bearerGroup">
       <property name="title">
        <string>Bearer token</string>
       </property>
       <layout class="QVBoxLayout" name="bearerLayout">
        <item>
         <widget class="QLabel" name="bearerNote">
          <property name="text">
           <string>Every MCP client must send the bridge's token. FreeCAD keeps a hash of it, not the token.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="tokenButtons">
          <item>
           <widget class="QPushButton" name="generateTokenButton">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Generate a new bearer token and show it once.</string>
            </property>
            <property name="text">
             <string>Generate new token</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="setTokenButton">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Paste a bearer token.</string>
            </property>
            <property name="text">
             <string>Set token</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="tokenSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>10</width>
              <height>10</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
