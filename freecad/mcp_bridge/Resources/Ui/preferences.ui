         </sizepolicy>
        </property>
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>A loopback entry uses http://127.0.0.1:&amp;lt;PORT&amp;gt;/mcp. By default, beyond loopback, use https://&amp;lt;ADDRESS&amp;gt;:&amp;lt;PORT&amp;gt;/mcp with the bearer token. &lt;b&gt;Apply to loopback&lt;/b&gt; extends that to loopback entries. Claude Desktop speaks stdio only and needs this connector: &lt;a href="https://github.com/CREATeNG/freecad-mcp-bridge/releases/latest/download/freecad-mcp-bridge.mcpb"&gt;Download the bundle&lt;/a&gt;.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="openExternalLinks">
         <bool>true</bool>
        </property>
