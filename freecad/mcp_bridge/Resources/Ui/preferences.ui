     <item>
      <widget class="QGroupBox" name="permissionsGroup">
       <property name="title">
        <string>Execution permission</string>
       </property>
       <layout class="QHBoxLayout" name="permissionModeRow">
        <item>
         <widget class="QLabel" name="permissionModeLabel">
          <property name="text">
           <string>Permission mode</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="permissionModeComboBox">
          <property name="toolTip">
           <string>Ask shows you an agent's code first. Unrestricted runs it unseen.</string>
          </property>
          <property name="currentIndex">
           <number>0</number>
          </property>
          <item>
           <property name="text">
            <string>Ask (default)</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Unrestricted</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="clientGroup">
     <property name="title">
      <string>Connect an MCP client</string>
     </property>
     <layout class="QVBoxLayout" name="clientLayout">
      <item>
       <widget class="QLabel" name="clientLoopbackNote">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>Without a TLS certificate, a loopback entry uses &lt;nobr&gt;http:&amp;#x2060;//&amp;#x2060;127.0.0.1&amp;#x2060;:&amp;#x2060;&amp;lt;PORT&amp;gt;/mcp&lt;/nobr&gt;.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="clientHttpsNote">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>With one, every entry uses &lt;nobr&gt;https:&amp;#x2060;//&amp;#x2060;&amp;lt;ADDRESS&amp;gt;&amp;#x2060;:&amp;#x2060;&amp;lt;PORT&amp;gt;/mcp&lt;/nobr&gt;, and beyond loopback one is required.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="clientTokenNote">
        <property name="text">
         <string>Every listener requires the bearer token.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="clientClaudeNote">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>Claude Desktop speaks stdio only and needs the MCP Bridge for FreeCAD extension: &lt;a href="https://github.com/CREATeNG/freecad-mcp-bridge/releases/latest/download/freecad-mcp-bridge.mcpb"&gt;Download the bundle&lt;/a&gt;.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="openExternalLinks">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="helpGroup">
     <property name="title">
      <string>Help &amp;&amp; feedback</string>
     </property>
     <layout class="QVBoxLayout" name="helpLayout">
      <item>
       <widget class="QLabel" name="helpNote">
        <property name="textFormat">
         <enum>Qt::RichText</enum>
        </property>
        <property name="text">
         <string>Report a bug, ask a question or suggest a feature: &lt;a href="https://github.com/CREATeNG/freecad-mcp-bridge/issues"&gt;GitHub issues&lt;/a&gt;.&lt;br/&gt;&lt;br/&gt;Project page and documentation: &lt;a href="https://github.com/CREATeNG/freecad-mcp-bridge"&gt;github.com/CREATeNG/freecad-mcp-bridge&lt;/a&gt;.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="openExternalLinks">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
