          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="retentionLabel">
            <property name="text">
             <string>Page history retention</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="Gui::PrefSpinBox" name="retentionSpinBox">
            <property name="toolTip">
             <string>Idle time before finished output expires.</string>
            </property>
            <property name="suffix">
             <string> min</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>1440</number>
            </property>
            <property name="value">
             <number>5</number>
            </property>
            <property name="prefEntry" stdset="0">
             <cstring>MaxHistoryRetentionMinutes</cstring>
            </property>
            <property name="prefPath" stdset="0">
             <cstring>Mod/freecad-mcp-bridge</cstring>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="statusBarGroup">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title">
          <string>MCP Bridge status bar widget</string>
         </property>
         <layout class="QHBoxLayout" name="statusBarLayout">
          <item>
           <widget class="Gui::PrefCheckBox" name="showStatusButtonCheckBox">
            <property name="toolTip">
             <string>Display toggle button in the status bar. Always shown in Unrestricted mode.</string>
            </property>
            <property name="text">
             <string>Show</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="prefEntry" stdset="0">
             <cstring>ShowStatusButton</cstring>
            </property>
            <property name="prefPath" stdset="0">
             <cstring>Mod/freecad-mcp-bridge</cstring>
            </property>
           </widget>
          </item>
          <item>
           <widget class="Gui::PrefComboBox" name="statusButtonPositionComboBox">
            <property name="toolTip">
             <string>Where the button sits on the status bar.</string>
            </property>
            <property name="currentIndex">
             <number>0</number>
            </property>
            <property name="prefEntry" stdset="0">
             <cstring>StatusButtonPosition</cstring>
            </property>
            <property name="prefPath" stdset="0">
             <cstring>Mod/freecad-mcp-bridge</cstring>
            </property>
            <item>
             <property name="text">
              <string>Right of FreeCAD's items (default)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Left of FreeCAD's items</string>
             </property>
            </item>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="tlsGroup">
     <property name="title">
      <string>TLS certificate: needed for any address beyond loopback</string>
     </property>
     <layout class="QVBoxLayout" name="tlsLayout">
      <item>
       <layout class="QHBoxLayout" name="tlsFiles">
        <item>
         <widget class="QLabel" name="tlsCertFileLabel">
          <property name="text">
           <string>Certificate (PEM)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefFileChooser" name="tlsCertFileChooser">
          <property name="toolTip">
           <string>PEM certificate file for HTTPS.</string>
          </property>
          <property name="fileName">
           <string/>
          </property>
          <property name="filter">
           <string>PEM files (*.pem *.crt *.key);;All files (*)</string>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>TlsCertFile</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>Mod/freecad-mcp-bridge</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="tlsKeyFileLabel">
          <property name="text">
           <string>Private key (PEM)</string>
          </property>
