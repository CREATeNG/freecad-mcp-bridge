          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <layout class="QVBoxLayout" name="rightColumn">
       <item>
        <widget class="QGroupBox" name="responsesGroup">
         <property name="title">
          <string>Responses</string>
         </property>
         <layout class="QFormLayout" name="responsesForm">
          <item row="0" column="0">
           <widget class="QLabel" name="timeoutLabel">
            <property name="text">
             <string>Max response timeout</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="Gui::PrefSpinBox" name="timeoutSpinBox">
            <property name="toolTip">
             <string>The bridge's wait per page.</string>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>600</number>
            </property>
            <property name="value">
             <number>15</number>
            </property>
            <property name="prefEntry" stdset="0">
             <cstring>MaxResponseTimeoutSeconds</cstring>
            </property>
            <property name="prefPath" stdset="0">
             <cstring>Mod/freecad-mcp-bridge</cstring>
            </property>
